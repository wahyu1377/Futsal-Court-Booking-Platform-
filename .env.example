# ============================================================
# Contoh konfigurasi database Arena Sport.
# Salin file ini menjadi ".env" di root repository, lalu isi nilainya.
# File ".env" sudah masuk .gitignore - jangan pernah di-commit.
# ============================================================

# pgsql = PostgreSQL/Supabase   |   mysql = MySQL/MariaDB lokal
DB_DRIVER=pgsql

# --- Supabase (session pooler, port 5432) ---
# Role aplikasi: pakai role non-privileged (mis. arena_app), BUKAN role postgres.
# Ambil dari: Supabase Dashboard > Settings > Database
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=arena_app.whmqodgxzjpbumtilrgr
DB_PASS=ganti-dengan-password-database-anda
DB_SSLMODE=require

# --- Contoh MySQL lokal (XAMPP) ---
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=arena_sport
# DB_USER=root
# DB_PASS=

# ============================================================
# Konfigurasi pembayaran DOKU (opsional).
# Ambil client_id & secret_key dari DOKU Back Office -> Integration -> API Keys.
# Nilai per mesin (app_url, notify_url) ada di arena-sport/backend/config/doku.local.php
# ============================================================
DOKU_ENV=sandbox
DOKU_CLIENT_ID=MCH-XXXX-XXXXXXXXXXXXX
DOKU_SECRET_KEY=SK-XXXXXXXXXXXXXXXXXXXX

# Alamat dasar folder arena-sport (dipakai untuk callback_url ke halaman tiket).
# OPSIONAL: kalau dikosongkan, aplikasi menebaknya sendiri dari alamat request.
# Isi manual hanya perlu untuk produksi (URL publik yang tidak bisa ditebak).
# DOKU_APP_URL=https://arena-sport.wasmer.app/arena-sport

# URL publik HTTPS ke doku_notify.php. WAJIB sama persis dengan URL yang
# didaftarkan di DOKU Back Office, kalau tidak verifikasi tanda tangan gagal.
# Catatan: Wasmer memakai root folder repository, jadi path-nya memakai awalan
# /arena-sport. Kalau root directory Wasmer diubah ke folder arena-sport,
# awalan ini ikut hilang.
# DOKU_NOTIFY_URL=https://arena-sport.wasmer.app/arena-sport/backend/api/payment/doku_notify.php

# ============================================================
# Konfigurasi fitur "Lupa Kata Sandi" (reset password).
# ============================================================

# Alamat dasar folder arena-sport. Dipakai untuk menyusun tautan reset
# yang dikirim ke email. Kalau dikosongkan, aplikasi menebaknya sendiri
# dari alamat request (cukup untuk localhost).
APP_URL=http://localhost:8000/arena-sport

# Cara pengiriman email:
#   log  = email tidak benar-benar dikirim, isi email ditulis ke
#          backend/logs/mail.log dan tautannya ditampilkan di layar
#          (mode demo, aman untuk magang)
#   smtp = email benar-benar dikirim lewat server SMTP
MAIL_MODE=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Kredensial SMTP. Untuk Gmail pakai "App Password", bukan password asli.
# Kosongkan kalau MAIL_MODE=log.
MAIL_USER=
MAIL_PASS=

# Pengirim email
MAIL_FROM=arena.sport@example.com
MAIL_FROM_NAME=Arena Sport

# ============================================================
# Google OAuth ("Masuk dengan Google")
# ============================================================
# Client ID OAuth 2.0 (tipe Web application) dari Google Cloud Console.
# Client ID bukan rahasia, boleh dipublikasikan.
# Kosongkan kalau mau memakai client ID bawaan di backend/config/google.php.
GOOGLE_CLIENT_ID=

# CATATAN: mengisi client ID saja belum cukup. Di Google Cloud Console ->
# Credentials -> OAuth 2.0 Client ID -> Authorized JavaScript origins,
# daftarkan ORIGIN aplikasi (scheme + host + port, tanpa path).
# Contoh: http://localhost:8000
# Port termasuk bagian dari origin, jadi "http://localhost" TIDAK sama
# dengan "http://localhost:8000".
